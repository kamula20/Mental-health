# Copy settings into your shell or hosting provider. This file is not auto-loaded.
# Default local demonstration:
BETWEEN_DEMO=1
BETWEEN_ENV=development
BETWEEN_BASE_URL=http://127.0.0.1:5000
BETWEEN_MAIL_MODE=preview
PORT=5000

# Production example: replace placeholders before starting.
# BETWEEN_ENV=production
# BETWEEN_DEMO=0
# BETWEEN_SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# BETWEEN_HTTPS=1
# BETWEEN_BASE_URL=https://YOUR_DOMAIN
# BETWEEN_DATABASE=/private/persistent/path/between.sqlite3
# BETWEEN_BIND_HOST=127.0.0.1
# BETWEEN_MAIL_MODE=smtp
# BETWEEN_SMTP_HOST=YOUR_SMTP_HOST
# BETWEEN_SMTP_PORT=587
# BETWEEN_SMTP_FROM=YOUR_WORKSPACE_EMAIL
# BETWEEN_SMTP_USERNAME=YOUR_SMTP_LOGIN
# BETWEEN_SMTP_PASSWORD=SET_THIS_IN_YOUR_SECRET_STORE
# BETWEEN_BACKUP_KEY=SET_A_FERNET_KEY_IN_YOUR_SECRET_STORE
# BETWEEN_EXTERNAL_EVALUATION=/private/path/external-evaluation.json
